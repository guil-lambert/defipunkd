{
  "manifest_version": 3,
  "name": "DeFiPunk'd for DeFiLlama (showcase)",
  "version": "0.2.0",
  "description": "Showcase: overlays DeFiPunk'd decentralization assessments (the risk pizza + tier) onto DeFiLlama protocol rankings and pages.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://defipunkd.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://defillama.com/*"],
      "run_at": "document_idle",
      "js": [
        "src/config.js",
        "src/index-fallback.js",
        "src/pizza.js",
        "src/common.js",
        "src/inject-table.js",
        "src/inject-protocol.js"
      ],
      "css": ["styles/defipunkd.css"]
    }
  ]
}
