{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://defipunkd.xyz/schema/slice-assessment.v2.json",
  "title": "defipunkdSliceAssessment",
  "description": "One slice of the 5-slice risk assessment for a DeFi protocol. Submitted by human contributors running the defipunkd prompt through an LLM of their choice, merged by a quorum bot into data/assessments/.",
  "type": "object",
  "required": [
    "schema_version",
    "slug",
    "slice",
    "snapshot_generated_at",
    "prompt_version",
    "analysis_date",
    "model",
    "grade",
    "headline",
    "rationale",
    "evidence",
    "unknowns"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "enum": [2, 3, 4] },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$" },
    "slice": {
      "type": "string",
      "enum": ["control", "ability-to-exit", "autonomy", "open-access", "verifiability"]
    },
    "snapshot_generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp of the DeFiLlama snapshot the assessment pins to."
    },
    "prompt_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Version of the defipunkd prompt the contributor ran. See packages/prompts/src/index.ts PROMPT_VERSION."
    },
    "analysis_date": {
      "type": "string",
      "format": "date",
      "description": "Date on which the contributor ran the prompt (UTC)."
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "Exact identifier of the LLM used, e.g. claude-opus-4-7, gpt-5, gemini-3-pro. Self-reported."
    },
    "chat_url": {
      "oneOf": [{ "type": "string", "format": "uri" }, { "type": "null" }],
      "description": "Optional shareable URL of the chat session that produced this assessment (claude.ai/share/..., chatgpt.com/share/..., g.co/gemini/share/..., etc.). Submissions with a verifiable chat_url are given extra weight by the quorum bot because the reasoning chain is independently re-readable."
    },
    "grading_basis": {
      "type": "string",
      "enum": ["on-chain", "off-chain-only", "mixed"]
    },
    "grade": {
      "type": "string",
      "enum": ["green", "orange", "red", "unknown"]
    },
    "headline": {
      "type": "string",
      "minLength": 1,
      "description": "One-line human-readable summary shown on the protocol card."
    },
    "short_headline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "rationale": {
      "type": "object",
      "description": "Structured explanation. Every factual claim in findings[] or verdict must map to an evidence[] entry.",
      "required": ["findings", "steelman", "verdict"],
      "additionalProperties": false,
      "properties": {
        "findings": {
          "type": "array",
          "description": "One entry per checklist item inspected. code must match the checklist prefix (e.g. E1, C2-emergency).",
          "items": {
            "type": "object",
            "required": ["code", "text"],
            "additionalProperties": false,
            "properties": {
              "code": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9-]{0,15}$" },
              "text": { "type": "string", "minLength": 1 }
            }
          }
        },
        "steelman": {
          "description": "One-sentence strongest argument for each of the three plausible grades. Must be null only when grade=\"unknown\".",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["red", "orange", "green"],
              "additionalProperties": false,
              "properties": {
                "red": { "type": "string", "minLength": 1 },
                "orange": { "type": "string", "minLength": 1 },
                "green": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "verdict": {
          "type": "string",
          "minLength": 1,
          "description": "One-sentence conclusion. Typically 'Choosing <grade> because <reason>.' For grade=unknown, summarize what blocked the assessment."
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "shows"],
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "shows": { "type": "string", "minLength": 1 },
          "chain": { "type": "string" },
          "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
          "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{7,40}$" },
          "fetched_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Things the contributor looked for but could not determine. Used by reviewers to direct follow-up runs."
    },
    "protocol_metadata": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "github": {
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        },
        "docs_url": {
          "oneOf": [{ "type": "string", "format": "uri" }, { "type": "null" }]
        },
        "audits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["firm", "url"],
            "additionalProperties": true,
            "properties": {
              "firm": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "format": "uri" },
              "date": { "type": "string", "pattern": "^\\d{4}(-\\d{2}){0,2}$" }
            }
          }
        },
        "governance_forum": {
          "oneOf": [{ "type": "string", "format": "uri" }, { "type": "null" }]
        },
        "voting_token": {
          "oneOf": [
            {
              "type": "object",
              "required": ["chain", "address"],
              "additionalProperties": true,
              "properties": {
                "chain": { "type": "string", "minLength": 1 },
                "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
                "symbol": { "type": "string", "minLength": 1, "maxLength": 32 }
              }
            },
            { "type": "null" }
          ]
        },
        "bug_bounty_url": {
          "oneOf": [{ "type": "string", "format": "uri" }, { "type": "null" }]
        },
        "security_contact": {
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "deployed_contracts_doc": {
          "oneOf": [{ "type": "string", "format": "uri" }, { "type": "null" }]
        },
        "admin_addresses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["chain", "address", "role", "actor_class"],
            "additionalProperties": true,
            "properties": {
              "chain": { "type": "string", "minLength": 1 },
              "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
              "role": { "type": "string", "minLength": 1 },
              "actor_class": { "enum": ["eoa", "multisig", "timelock", "governance", "unknown"] }
            }
          }
        },
        "upgradeability": {
          "oneOf": [{ "enum": ["immutable", "upgradeable", "mixed", "unknown"] }, { "type": "null" }]
        },
        "about": {
          "oneOf": [{ "type": "string" }, { "type": "null" }]
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "grade": { "const": "unknown" } } },
      "then": { "properties": { "unknowns": { "minItems": 1 } } },
      "else": {
        "properties": {
          "evidence": { "minItems": 1 },
          "rationale": { "properties": { "steelman": { "type": "object" } } }
        }
      }
    }
  ]
}
