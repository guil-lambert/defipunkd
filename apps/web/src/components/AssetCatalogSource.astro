---
import SourceLogo from "./SourceLogo.astro";
interface Props { fetchedAt: string; asOf?: string; href?: string }
const { fetchedAt, asOf, href = "https://tokenizedstonks.io/assets" } = Astro.props;
const stale = Date.now() - Date.parse(asOf ?? fetchedAt) > 14 * 86400_000;
---
<p class="source">Catalog source: <a href={href} target="_blank" rel="noopener noreferrer"><SourceLogo source="tokenizedstonks" size={18} />tokenizedstonks.io ↗</a> · Retrieved <time datetime={fetchedAt}>{fetchedAt.slice(0, 10)}</time>{asOf && <> · Source snapshot <time datetime={asOf}>{asOf.slice(0, 10)}</time></>}</p>
{stale && <p class="stale">Saved catalog is over two weeks old. Check the source for current coverage.</p>}
<style>
.source { color: var(--text-muted); font-size: .8rem; line-height: 1.7; }
a { display: inline-flex; align-items: center; gap: .3rem; }
.stale { font-size: .85rem; }
</style>
