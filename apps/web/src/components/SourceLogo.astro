---
import { SOURCE_LOGOS, sourceBrandForUrl, type SourceBrand } from "../lib/source-logos";
interface Props { source?: SourceBrand; href?: string | null; size?: number }
const { source, href, size = 16 } = Astro.props;
const brand = source ?? sourceBrandForUrl(href);
---
{brand && <img class="source-logo" src={SOURCE_LOGOS[brand]} width={size} height={size} alt="" aria-hidden="true" />}
<style>
  .source-logo { display: inline-block; vertical-align: -0.2em; object-fit: contain; flex-shrink: 0; margin-inline-end: 0.3em; }
</style>
